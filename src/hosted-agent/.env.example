# ローカル実行時の環境変数例。Hostedコードはこのファイルを自動読込しません。
# Azure HostedではFOUNDRY_PROJECT_ENDPOINTはプラットフォーム注入値を使用します。
FOUNDRY_PROJECT_ENDPOINT=
PROCUREMENT_PARENT_MODEL_DEPLOYMENT=
PROCUREMENT_CATALOG_AGENT_NAME=catalog-search-agent
PROCUREMENT_CATALOG_AGENT_VERSION=1
PROCUREMENT_CODE_AGENT_NAME=code-determination-agent
PROCUREMENT_CODE_AGENT_VERSION=1
# OBO検証を使う場合だけ、移植先Toolboxのendpointを設定します。
PROCUREMENT_IDENTITY_TOOLBOX_ENDPOINT=
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
PROCUREMENT_ENABLE_SYNTHETIC_INJECTIONS=false
