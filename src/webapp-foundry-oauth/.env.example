# 購買支援の接続先。既存のAPIM経路を維持します。
PROJECT_ENDPOINT=https://apim-procurement-stream-nkjm.azure-api.net/foundry/proj-default
AGENT_NAME=procurement-parent-agent
WEB_APP_URL=https://web-procurement-observe-nkjm.azurewebsites.net
FOUNDRY_USER_AUTH_MODE=refresh_token
FOUNDRY_TOKEN_SCOPES=https://ai.azure.com/.default
FOUNDRY_OBO_TENANT_ID=
FOUNDRY_OBO_CLIENT_ID=
# App Serviceではシークレット参照等を設定し、実際の秘密値をコミットしないでください。
ENTRA_CLIENT_SECRET=
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_PROPAGATORS=tracecontext,baggage
WEBUI_ALLOW_ANONYMOUS=false
