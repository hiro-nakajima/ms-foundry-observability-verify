# ─────────────────────────────────────────────────────────────────────────────
# Foundry OAuth UI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# (Required) Responses API base endpoint seen by this app.
# Recommended for APIM fronting Foundry:
#   https://<apim-name>.azure-api.net/foundry/<project-name>
# The app appends /agents/<AGENT_NAME>/endpoint/protocols/openai/responses?api-version=v1 internally.
PROJECT_ENDPOINT=https://apim-mcp-handson.azure-api.net/foundry/proj-default

# (Required) Foundry Agent name used in the new stable Agent endpoint path.
# AGENT_REFERENCE_NAME is still accepted by the backend as a deprecated alias,
# but new deployments should set AGENT_NAME.
AGENT_NAME=your-agent-name

# (Required for APIM mode) Subscription key used by App Service -> APIM.
# Leave unset only when calling Foundry directly without APIM.
APIM_SUBSCRIPTION_KEY=your-apim-subscription-key

# (Optional) Comma-separated list of CORS origins allowed to call this server.
# Default: local FastAPI UI and legacy frontend dev origin
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────
# Direct Foundry mode only:
# The server uses DefaultAzureCredential (azure-identity) to acquire a token
# for the "https://ai.azure.com/.default" scope when APIM_SUBSCRIPTION_KEY is
# not set. In APIM mode, APIM authenticates to Foundry with its own managed
# identity and this app does not request a Foundry token.
#
# In local development, run:  az login
# In production (Azure App Service / Container Apps):
#   - Assign a User-Assigned or System-Assigned Managed Identity with the
#     "Azure AI User" role on the Foundry project.
#   - Set AZURE_CLIENT_ID if using a User-Assigned identity.
#
# AZURE_CLIENT_ID=<managed-identity-client-id>   # optional for UAMI
