PROCUREMENT_DATA_DIR=./data
PROCUREMENT_GOVERNANCE_MODE=shadow
PROCUREMENT_RECORD_RAW_CONTENT=false
PROCUREMENT_LOGICAL_PATTERN=HA-S
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_MODEL=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_TIMEOUT_SECONDS=90
# Use a value supported by the deployed model. gpt-5-mini 2025-08-07 uses minimal.
AZURE_OPENAI_REASONING_EFFORT=
AZURE_OPENAI_MAX_OUTPUT_TOKENS=2048
# DefaultAzureCredential is preferred. Never commit AZURE_OPENAI_API_KEY.
